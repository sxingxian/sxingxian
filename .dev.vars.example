# Copy to .dev.vars for local development. NEVER commit .dev.vars.
# In production these are set in Cloudflare → sxingxian → Settings → Variables and secrets
# (see docs/DEPLOYMENT.md), or with:  npx wrangler secret put <NAME>

# Neon connection string — paste the pooled string from the Neon console
# (use a separate Neon dev branch for local work)
DATABASE_URL=

# Encrypts 2FA (authenticator) secrets at rest. 32+ random characters: openssl rand -hex 32
AUTH_SECRET=

# One-time token that unlocks /admin/setup while no admin account exists. Remove it afterwards.
SETUP_TOKEN=

# Shared secret for the WordPress webhook (same value in hey.sxingxian.com wp-config.php)
WP_WEBHOOK_SECRET=

# Optional: S3-compatible credentials for the NAS (via Cloudflare Tunnel) and Backblaze B2
NAS_S3_ACCESS_KEY_ID=
NAS_S3_SECRET_ACCESS_KEY=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=
