---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/site.css';
import { getSettings } from '../lib/server/repo';
import { navItems } from '../lib/server/site';
import { isSafeHref } from '../lib/shared/safe';
import { adsFor } from '../lib/server/ads';
import { getSetting, hasPrivacyPage } from '../lib/server/repo';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  /** Home page: reveal-on-view motion. */
  motion?: boolean;
  /** Home page without a topic filter: the intro curtain on the first visit in a session. */
  intro?: boolean;
}
const { title, description, noindex = false, image, motion = false, intro = false } = Astro.props;
const { site, sections, footer } = await getSettings(['site', 'sections', 'footer']);
const nav = navItems(sections);
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' || path.startsWith('/story') : path.startsWith(href));
// Tagline next to the name: the one set in Settings, or else the current section's name.
const sectionName = (() => {
  if (path === '/' || path.startsWith('/story')) return 'stories';
  const hit = nav.find((n) => n.href !== '/' && path.startsWith(n.href));
  return hit ? hit.label.toLowerCase() : '';
})();
const tagline = site.tagline.trim() || sectionName;
const pageTitle = title ? `${title} · ${site.title}` : tagline ? `${site.title} — ${tagline}` : site.title;
const desc = description || footer.about;
const year = String(new Date().getUTCFullYear());
const columns = footer.columns.map((c) => ({ ...c, links: c.links.filter((l) => isSafeHref(l.url)) }));
const hasRssLink = columns.some((c) => c.links.some((l) => l.url === '/rss.xml'));
const canonical = new URL(path, Astro.site ?? Astro.url).toString();
const ads = await adsFor(path);
const showPrivacy = await hasPrivacyPage().catch(() => false);
const protect = (await getSetting('protection').catch(() => null))?.blockSave ?? true;
const curtainLetters = Array.from(site.title).map((ch, i) => ({ ch: ch === ' ' ? '\u00a0' : ch, cls: `l l${Math.min(i + 1, 12)}` }));
import Favicons from '../components/Favicons.astro';
---
<!doctype html>
<html lang="en" data-protect={protect ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.title} — RSS`} href="/rss.xml" />
    <Favicons />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    <!-- Apply a saved theme before first paint (no flash). Default: follow the device. -->
    {ads && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`} crossorigin="anonymous" is:inline></script>
    )}
    {/* Broken images: swap in the site's placeholder. Registered before any <img> so it catches every failure
         (error events don't bubble, so it listens in the capture phase). No inline onerror: the CSP forbids it. */}
    <script is:inline>(function(){function ph(img){var alt=img.getAttribute('alt')||'';var n=document.createElement('div');n.className='placeholder-cover is-broken';n.textContent='sxingxian';if(alt){n.setAttribute('role','img');n.setAttribute('aria-label',alt);}else{n.setAttribute('aria-hidden','true');}return n;}document.addEventListener('error',function(e){var img=e.target;if(!img||img.tagName!=='IMG'||img.hasAttribute('data-ph'))return;if(img.classList.contains('lb-img')){var st=img.parentNode;if(st&&img.getAttribute('src')){st.classList.add('is-broken');img.addEventListener('load',function(){st.classList.remove('is-broken');},{once:true});}return;}img.setAttribute('data-ph','');var lb=img.closest('.lb');if(lb){lb.removeAttribute('data-lightbox');lb.setAttribute('data-broken','');lb.disabled=true;lb.setAttribute('aria-label','Photo unavailable');}img.replaceWith(ph(img));},true);})();</script>
    <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('sx-theme');if(t==='light'||t==='dark')d.setAttribute('data-theme',t);}catch(e){}})();</script>
    {/* Before first paint: hide reveal targets and decide on the intro. The first home visit in a session gets the
         intro (unless reduced motion); later visits are 'returning'. Fails open after 3 s if the page script never ran. */}
    {motion && (
      <script is:inline data-intro={intro ? '1' : '0'}>(function(){var d=document.documentElement,s=document.currentScript;if(!('IntersectionObserver' in window))return;d.classList.add('motion');var rm=false;try{rm=window.matchMedia('(prefers-reduced-motion: reduce)').matches;}catch(e){}var seen='1';try{seen=sessionStorage.getItem('sx-home');sessionStorage.setItem('sx-home','1');}catch(e){}if(seen)d.classList.add('returning');else if(s&&s.getAttribute('data-intro')==='1'&&!rm)d.classList.add('intro');setTimeout(function(){if(!d.hasAttribute('data-rv-ready'))d.classList.remove('motion','intro');},3000);})();</script>
    )}
  </head>
  <body>
    {intro && (
      <div class="intro-curtain" aria-hidden="true">
        <span class="cur-mark"><span class="cur-word">{curtainLetters.map((l) => <span class={l.cls}><span>{l.ch}</span></span>)}</span>{tagline && <span class="cur-sub">{tagline}</span>}</span>
        <span class="cur-bar"></span>
      </div>
    )}
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${site.title} home`}><b>{site.title}</b>{tagline && <i>{tagline}</i>}</a>
        <nav class="nav" aria-label="Primary">
          {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="head-actions">
          <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch theme">
            <svg class="i-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
            <svg class="i-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path></svg>
          </button>
          <a class="btn rss-btn" href="/rss.xml" aria-label="RSS feed">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8M5 4a15 15 0 0 1 15 15"></path><circle cx="6" cy="18" r="1.5" fill="currentColor"></circle></svg>
            RSS
          </a>
          <button type="button" class="icon-btn menu-btn" data-menu-open aria-controls="site-menu" aria-expanded="false" aria-label="Menu">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="menu-sheet" id="site-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
      <div class="sheet-head">
        <a class="brand" href="/"><b>{site.title}</b>{tagline && <i>{tagline}</i>}</a>
        <button type="button" class="icon-btn" data-menu-close aria-label="Close menu">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <nav aria-label="Primary">
        {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="sheet-theme">
        <span class="lbl" id="menu-theme-l">Theme</span>
        <div class="theme-seg" role="radiogroup" aria-labelledby="menu-theme-l">
          <button type="button" role="radio" aria-checked="true" data-theme-set="system">System</button>
          <button type="button" role="radio" aria-checked="false" data-theme-set="light">Light</button>
          <button type="button" role="radio" aria-checked="false" data-theme-set="dark">Dark</button>
        </div>
      </div>
      <div class="sheet-foot">
        <a href="/rss.xml">RSS</a>
        {columns.flatMap((c) => c.links).filter((l) => l.url.startsWith('https:')).slice(0, 3).map((l) => (
          <a href={l.url} rel="noopener noreferrer">{l.label}</a>
        ))}
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot-grid">
        <div class="foot-about"><b>{site.title}</b><span>{footer.about}</span></div>
        {columns.map((c) => (
          <div class="col-links">
            <span class="lbl">{c.heading}</span>
            {c.links.map((l) => l.newTab ? (
              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}{!l.label.includes('↗') && <span class="ext" aria-hidden="true">↗</span>}<span class="sr-only"> (opens in a new tab)</span></a>
            ) : (
              <a href={l.url} rel={l.url.startsWith('https:') ? 'noopener noreferrer' : undefined}>{l.label}</a>
            ))}
          </div>
        ))}
        {footer.showRss && !hasRssLink && (
          <div class="col-links"><span class="lbl">Follow</span><a href="/rss.xml">RSS feed</a></div>
        )}
      </div>
      <div class="wrap foot-bottom">
        <span>{footer.bottomLine.replaceAll('{year}', year)}{footer.showBuiltOn && ' · Built on Cloudflare'}{showPrivacy && <> · <a href="/privacy">Privacy</a></>}</span>
        <div class="theme-seg" role="radiogroup" aria-label="Theme">
          <button type="button" role="radio" aria-checked="true" data-theme-set="system">Auto</button>
          <button type="button" role="radio" aria-checked="false" data-theme-set="light">Light</button>
          <button type="button" role="radio" aria-checked="false" data-theme-set="dark">Dark</button>
        </div>
      </div>
    </footer>

    <!-- Theme switch and phone menu. Small, no dependencies; the site works without it. -->
    <script is:inline>
    (function () {
      var d = document.documentElement, KEY = 'sx-theme';
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      function saved() { try { var t = localStorage.getItem(KEY); return t === 'light' || t === 'dark' ? t : 'system'; } catch (e) { return 'system'; } }
      function effective(pref) { return pref === 'system' ? (mq.matches ? 'dark' : 'light') : pref; }
      function set(pref) {
        try { if (pref === 'system') localStorage.removeItem(KEY); else localStorage.setItem(KEY, pref); } catch (e) {}
        if (pref === 'system') d.removeAttribute('data-theme'); else d.setAttribute('data-theme', pref);
        sync();
      }
      // The new theme spreads in a circle from the button (View Transitions; instant elsewhere or with reduced motion).
      function apply(pref, btn) {
        var before = effective(saved()), after = effective(pref);
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (before === after || still || !document.startViewTransition || !btn) { set(pref); return; }
        var r = btn.getBoundingClientRect();
        d.style.setProperty('--vx', (r.left + r.width / 2) + 'px');
        d.style.setProperty('--vy', (r.top + r.height / 2) + 'px');
        d.setAttribute('data-vt', 'theme');
        var t = document.startViewTransition(function () { set(pref); });
        t.finished.finally(function () { d.removeAttribute('data-vt'); });
      }
      function sync() {
        var pref = saved(), eff = effective(pref);
        document.querySelectorAll('[data-theme-set]').forEach(function (b) { b.setAttribute('aria-checked', String(b.getAttribute('data-theme-set') === pref)); });
        document.querySelectorAll('[data-theme-toggle]').forEach(function (b) { b.setAttribute('aria-label', eff === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'); });
      }
      document.addEventListener('click', function (e) {
        var t = e.target.closest && e.target.closest('[data-theme-toggle],[data-theme-set],[data-menu-open],[data-menu-close]');
        if (!t) return;
        if (t.hasAttribute('data-theme-toggle')) apply(effective(saved()) === 'dark' ? 'light' : 'dark', t);
        else if (t.hasAttribute('data-theme-set')) apply(t.getAttribute('data-theme-set'), t);
        else if (t.hasAttribute('data-menu-open')) openMenu(true);
        else if (t.hasAttribute('data-menu-close')) openMenu(false);
      });
      if (mq.addEventListener) mq.addEventListener('change', sync);
      var menu = document.getElementById('site-menu'), opener = document.querySelector('[data-menu-open]');
      function openMenu(on) {
        if (!menu) return;
        menu.hidden = !on;
        document.body.style.overflow = on ? 'hidden' : '';
        if (opener) opener.setAttribute('aria-expanded', String(on));
        if (on) { var c = menu.querySelector('[data-menu-close]'); if (c) c.focus(); } else if (opener) opener.focus();
      }
      document.addEventListener('keydown', function (e) {
        if (!menu || menu.hidden) return;
        if (e.key === 'Escape') { openMenu(false); return; }
        if (e.key !== 'Tab') return;
        var f = menu.querySelectorAll('a[href], button');
        if (!f.length) return;
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
        else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
      });
      window.addEventListener('resize', function () { if (menu && !menu.hidden && window.innerWidth > 760) openMenu(false); });
      sync();
    })();
    </script>

    <!-- Most read: counts a read after 15 s of a story being on screen, or a click through to a WordPress post.
         Sends only which story was read (no cookies, ids or fingerprints); once per story per tab. -->
    <script is:inline>
    (function () {
      if (!navigator.sendBeacon) return;
      function send(item) {
        var k = 'sx-read:' + item;
        try { if (sessionStorage.getItem(k)) return; sessionStorage.setItem(k, '1'); } catch (e) {}
        navigator.sendBeacon('/api/views', new Blob([JSON.stringify({ item: item })], { type: 'text/plain' }));
      }
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-view]');
        if (a) send(a.getAttribute('data-view'));
      });
      var art = document.querySelector('[data-read]');
      if (!art) return;
      var item = art.getAttribute('data-read'), seen = 0, last = Date.now(), t;
      function tick() {
        var now = Date.now();
        if (!document.hidden) seen += now - last;
        last = now;
        if (seen >= 15000) { clearInterval(t); send(item); }
      }
      t = setInterval(tick, 1000);
      document.addEventListener('visibilitychange', function () { last = Date.now(); });
    })();
    </script>

    <!-- Photo lightbox and save blockers. Captions are set with textContent (never as HTML). -->
    <script is:inline>
    (function () {
      var d = document.documentElement;
      if (d.hasAttribute('data-protect')) {
        var isImg = function (t) { return t && t.closest && t.closest('img, picture, .lb, .lightbox'); };
        document.addEventListener('contextmenu', function (e) { if (isImg(e.target)) e.preventDefault(); });
        document.addEventListener('dragstart', function (e) { if (isImg(e.target)) e.preventDefault(); });
      }
      // Photos in a gallery step through that gallery only (data-lb-group); other photos step through each other.
      var all = Array.prototype.slice.call(document.querySelectorAll('[data-lightbox]'));
      if (!all.length) return;
      var items = all;
      function groupOf(t) { return t.getAttribute('data-lb-group') || ''; }
      var box, img, cap, count, prevBtn, nextBtn, idx = 0, opener = null, startX = 0;
      function el(tag, cls, attrs) { var n = document.createElement(tag); if (cls) n.className = cls; for (var k in attrs || {}) n.setAttribute(k, attrs[k]); return n; }
      function build() {
        box = el('div', 'lightbox', { role: 'dialog', 'aria-modal': 'true', 'aria-label': 'Photo viewer' });
        var close = el('button', 'lb-close', { type: 'button', 'aria-label': 'Close' }); close.textContent = '×';
        prevBtn = el('button', 'lb-nav lb-prev', { type: 'button', 'aria-label': 'Previous photo' }); prevBtn.textContent = '‹';
        nextBtn = el('button', 'lb-nav lb-next', { type: 'button', 'aria-label': 'Next photo' }); nextBtn.textContent = '›';
        var stage = el('div', 'lb-stage');
        img = el('img', 'lb-img', { alt: '', draggable: 'false' });
        stage.appendChild(img);
        var foot = el('div', 'lb-foot');
        cap = el('span', 'lb-cap'); count = el('span', 'lb-count');
        foot.appendChild(cap); foot.appendChild(count);
        box.appendChild(stage); box.appendChild(prevBtn); box.appendChild(nextBtn); box.appendChild(close); box.appendChild(foot);
        close.addEventListener('click', hide);
        prevBtn.addEventListener('click', function () { go(-1); });
        nextBtn.addEventListener('click', function () { go(1); });
        stage.addEventListener('click', function (e) { if (e.target === stage) hide(); });
        box.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
        box.addEventListener('touchend', function (e) { var dx = e.changedTouches[0].clientX - startX; if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1); });
        document.body.appendChild(box);
      }
      function show(i) {
        if (!box) build();
        items = items.filter(function (t) { return !t.hasAttribute('data-broken'); });
        if (!items.length) { hide(); return; }
        idx = (i + items.length) % items.length;
        var t = items[idx], src = t.querySelector('img');
        img.src = src ? src.currentSrc || src.src : '';
        img.alt = src ? src.alt : '';
        cap.textContent = t.getAttribute('data-caption') || '';
        count.textContent = items.length > 1 ? (idx + 1) + ' / ' + items.length : '';
        prevBtn.hidden = nextBtn.hidden = items.length < 2;
      }
      function open(i, from) { opener = from; show(i); box.hidden = false; document.body.style.overflow = 'hidden'; box.querySelector('.lb-close').focus(); }
      function hide() { if (!box) return; box.hidden = true; document.body.style.overflow = ''; img.removeAttribute('src'); if (opener) opener.focus(); }
      function go(step) { show(idx + step); }
      all.forEach(function (t) {
        t.addEventListener('click', function () {
          if (t.hasAttribute('data-broken')) return;
          var g = groupOf(t);
          items = all.filter(function (x) { return groupOf(x) === g && !x.hasAttribute('data-broken'); });
          open(Math.max(0, items.indexOf(t)), t);
        });
      });
      document.addEventListener('keydown', function (e) {
        if (!box || box.hidden) return;
        if (e.key === 'Escape') hide();
        else if (e.key === 'ArrowRight') go(1);
        else if (e.key === 'ArrowLeft') go(-1);
        else if (e.key === 'Tab') {
          var f = Array.prototype.filter.call(box.querySelectorAll('button'), function (b) { return !b.hidden; });
          if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
          else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
        }
      });
    })();
    </script>
  </body>
</html>
