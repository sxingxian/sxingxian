---
// The Contact page: written in the admin (Pages → Contact), shown once it has content and is switched on.
import Site from '../layouts/Site.astro';
import NotFound from '../components/NotFound.astro';
import PdfViewer from '../components/PdfViewer.astro';
import { getPage, getSetting } from '../lib/server/repo';
import { renderDoc } from '../lib/server/render';

const sections = await getSetting('sections');
const page = sections.contact ? await getPage('contact') : null;
const hasContent = !!page && Array.isArray(page.body?.content) && page.body.content.length > 0;
if (!hasContent) Astro.response.status = 404;
const html = hasContent && page ? renderDoc(page.body) : '';
---
{hasContent && page ? (
  <Site title={page.title || 'Contact'} noindex={page.noindex}>
    <article class="article">
      <h1>{page.title || 'Contact'}</h1>
      <div class="prose" set:html={html} />
      {html.includes('data-pdf=') && <PdfViewer />}
    </article>
  </Site>
) : (
  <NotFound />
)}
