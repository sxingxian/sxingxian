---
import Site from '../../layouts/Site.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { listPublicSeries } from '../../lib/server/series';

const series = await listPublicSeries(60);
---
<Site title="Series" description="Stories told in several parts.">
  <section class="wrap">
    <header class="page-head"><h1>Series</h1><p>Stories written in parts.</p></header>
    {series.length === 0 ? (
      <p class="empty" style="margin-top:24px">No series yet.</p>
    ) : (
      <div class="series-grid" style="padding-top:24px">
        {series.map((s) => <SeriesCard series={s} />)}
      </div>
    )}
  </section>
</Site>
