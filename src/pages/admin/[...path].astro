---
// /admin and every sub-route render the admin single-page app.
// Access to this route is enforced in src/middleware.ts (admin session; accounts in Neon).
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/jetbrains-mono';
import AdminApp from '../../admin/App';
import Favicons from '../../components/Favicons.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · sxingxian</title>
    <Favicons />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>(function(){try{var t=localStorage.getItem('sx-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
  </head>
  <body>
    <AdminApp client:only="react" />
  </body>
</html>
