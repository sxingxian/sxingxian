---
import Site from '../layouts/Site.astro';
import PostRow from '../components/PostRow.astro';
import Thumb from '../components/Thumb.astro';
import AdSlot from '../components/AdSlot.astro';
import { getFeatured, getFeed } from '../lib/server/site';
import { getSettings, listPublicEntries } from '../lib/server/repo';
import { formatDate } from '../lib/server/text';
import { topicLabel } from '../lib/shared/types';

const { site, sections } = await getSettings(['site', 'sections']);
const rawTopic = Astro.url.searchParams.get('topic') ?? '';
const topic = site.topics.includes(rawTopic) ? rawTopic : '';

const featured = topic ? null : await getFeatured();
const [feed, work, galleries, films] = await Promise.all([
  getFeed({ topic, limit: 10, excludeId: featured?.id }),
  sections.work ? listPublicEntries('project', { limit: 3 }) : Promise.resolve([]),
  sections.photos ? listPublicEntries('gallery', { limit: 6 }) : Promise.resolve([]),
  sections.film ? listPublicEntries('film', { limit: 1 }) : Promise.resolve([]),
]);
const latestFilm = films[0];
const words = featured ? featured.title.trim().split(/\s+/) : [];
const coverName = featured && featured.cover_media_id ? `view-transition-name:c-${featured.id.replace(/[^a-zA-Z0-9-]/g, '')}` : undefined;
---
<Site motion intro={!topic}>
  {featured && (
    <section class="wrap">
      <article class="featured">
        <a class="cover rv-cover" data-rv="fcover" href={`/story/${featured.slug}`} tabindex="-1" aria-hidden="true" style={coverName}>
          <span class="par"><Thumb image={featured.cover_media_id ? { kind: 'media', id: featured.cover_media_id } : null} eager /></span>
        </a>
        <div class="stack">
          <span class="row-meta rv" data-rv="fmeta">
            <span class="lbl accent">Featured{featured.topics.length ? ` · ${topicLabel(featured.topics)}` : ''}</span>
            <span class="meta">{formatDate(featured.published_at)} · {featured.read_minutes} min</span>
          </span>
          <h1 class="title rv" data-rv="ftitle"><a href={`/story/${featured.slug}`}>{words.map((w, i) => (<><span class={`w w${Math.min(i + 1, 14)}`}><span>{w}</span></span>{i < words.length - 1 ? ' ' : ''}</>))}</a></h1>
          {featured.dek && <p class="rv" data-rv="fdek">{featured.dek}</p>}
          <a class="read rv" data-rv="fread" href={`/story/${featured.slug}`}>Read <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
    </section>
  )}

  <section class="wrap main">
    <div>
      <div class="list-head rv" data-rv="lhead">
        <h2>{topic ? topic : 'Latest'}</h2>
        <nav class="topics" aria-label="Filter by topic">
          <a class="topic" href="/" aria-current={topic === '' ? 'true' : undefined}>All</a>
          {site.topics.map((t) => (
            <a class="topic" href={`/?topic=${encodeURIComponent(t)}`} aria-current={topic === t ? 'true' : undefined}>{t}</a>
          ))}
        </nav>
      </div>
      <div class="feed">
        {feed.length === 0 ? (
          <p class="empty">No posts here yet.</p>
        ) : (
          feed.map((item) => <PostRow item={item} reveal />)
        )}
      </div>
      <div class="pager rv" data-rv="pager"><span></span><a href={topic ? `/story?topic=${encodeURIComponent(topic)}` : '/story'}>All stories <span class="arrow" aria-hidden="true">→</span></a></div>
      <AdSlot slot="home" />
    </div>

    <aside class="side" aria-label="More from sxingxian">
      <div class="card rv" data-rv="side">
        <span class="lbl">Follow along</span>
        <p style="margin:8px 0 0;font-size:14px;color:var(--ink-2)">Every story, from here and from hey.sxingxian.com, in one feed for your reader.</p>
        <div class="rss-url"><code>sxingxian.com/rss.xml</code><a href="/rss.xml">Open</a></div>
      </div>

      {sections.work && work.length > 0 && (
        <div class="card rv" data-rv="side">
          <div class="card-head"><span class="lbl">Selected work</span><a href="/work">All <span class="arrow" aria-hidden="true">→</span></a></div>
          {work.map((w) => (
            <a class="mini" href={`/work/${w.slug}`}>
              <span class="th"><Thumb image={w.cover_media_id ? { kind: 'media', id: w.cover_media_id } : null} /></span>
              <span><b>{w.title}</b><span>{w.dek}</span></span>
            </a>
          ))}
        </div>
      )}

      {sections.photos && galleries.length > 0 && (
        <div class="card rv" data-rv="side">
          <div class="card-head"><span class="lbl">Photos</span><a href="/photos">Galleries <span class="arrow" aria-hidden="true">→</span></a></div>
          <div class="photo-grid">
            {galleries.map((g) => (
              <a href={`/photos/${g.slug}`} aria-label={g.title}>
                <Thumb image={g.cover_media_id ? { kind: 'media', id: g.cover_media_id } : null} alt={g.title} />
              </a>
            ))}
          </div>
        </div>
      )}

      {sections.film && latestFilm && (
        <a class="card mini rv" data-rv="side" style="border-top:1px solid var(--line);align-items:center" href={`/film/${latestFilm.slug}`}>
          <span class="th" style="width:92px;height:58px"><Thumb image={latestFilm.cover_media_id ? { kind: 'media', id: latestFilm.cover_media_id } : null} /></span>
          <span><span class="lbl">Latest film</span><b>{latestFilm.title}</b></span>
        </a>
      )}
    </aside>
  </section>

  <!-- Reveal-on-view. html.motion (set in <head>) hides [data-rv] until this marks them seen.
       First visit in a session: a staggered load sequence (after the intro curtain, if shown).
       Later visits: what's on screen is shown at once; the rest reveals once as it scrolls in. -->
  <script is:inline>
  (function () {
    var d = document.documentElement;
    if (!d.classList.contains('motion')) return;
    var els = Array.prototype.slice.call(document.querySelectorAll('[data-rv]'));
    var FIXED = { fcover: 0, fmeta: 1, ftitle: 2, fdek: 3, fread: 4 };
    function reveal(list) {
      list.sort(function (a, b) { var ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect(); return Math.abs(ra.top - rb.top) < 24 ? ra.left - rb.left : ra.top - rb.top; });
      var n = list.some(function (el) { return FIXED[el.getAttribute('data-rv')] !== undefined; }) ? 3 : 0;
      list.forEach(function (el) {
        var f = FIXED[el.getAttribute('data-rv')];
        el.style.transitionDelay = ((f !== undefined ? f : Math.min(9, n++)) * 70) + 'ms';
        el.classList.add('in');
      });
    }
    var io = new IntersectionObserver(function (entries) {
      var fresh = [];
      entries.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); fresh.push(e.target); } });
      if (fresh.length) reveal(fresh);
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    function start() {
      if (start.done) return;
      start.done = true;
      // What's already on screen reveals now, in reading order; the rest waits for the observer.
      var h = window.innerHeight * 0.94, now = [];
      els.forEach(function (el) { var r = el.getBoundingClientRect(); if (r.top < h && r.bottom > 0) now.push(el); else io.observe(el); });
      if (now.length) reveal(now); // the rect reads above already flushed the hidden styles, so this transitions
    }
    if (d.classList.contains('returning')) {
      // Back on the home page this session: no load sequence for what's already on screen.
      var h = window.innerHeight;
      els.forEach(function (el) { var r = el.getBoundingClientRect(); if (r.top < h && r.bottom > 0) el.classList.add('in', 'now'); });
      requestAnimationFrame(function () { requestAnimationFrame(function () { els.forEach(function (el) { el.classList.remove('now'); }); }); });
      els = els.filter(function (el) { return !el.classList.contains('in'); });
      start();
    } else if (d.classList.contains('intro')) {
      var curtain = document.querySelector('.intro-curtain');
      var evs = ['pointerdown', 'wheel', 'touchstart', 'keydown'];
      var off = function () { evs.forEach(function (ev) { window.removeEventListener(ev, skip); }); };
      var done = function () { d.classList.remove('intro', 'intro-skip'); if (curtain) curtain.remove(); off(); };
      var t1 = setTimeout(start, 1250);   // the page's own reveal begins under the lifting curtain
      var t2 = setTimeout(done, 1800);
      var skip = function () { clearTimeout(t1); clearTimeout(t2); d.classList.add('intro-skip'); start(); setTimeout(done, 240); off(); };
      evs.forEach(function (ev) { window.addEventListener(ev, skip, { passive: true }); });
    } else {
      start();
    }
    d.setAttribute('data-rv-ready', '');
  })();
  </script>
</Site>
