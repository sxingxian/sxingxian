---
import Site from '../layouts/Site.astro';
import PostRow from '../components/PostRow.astro';
import Thumb from '../components/Thumb.astro';
import AdSlot from '../components/AdSlot.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { getFeaturedList, getFeed, mostRead } from '../lib/server/site';
import { listPublicSeries } from '../lib/server/series';
import { getSettings, listPublicEntries } from '../lib/server/repo';
import { formatDate } from '../lib/server/text';
import { FEATURED_INTERVAL_S, topicLabel } from '../lib/shared/types';

const { site, sections } = await getSettings(['site', 'sections']);
const rawTopic = Astro.url.searchParams.get('topic') ?? '';
const topic = site.topics.includes(rawTopic) ? rawTopic : '';

// Featured stories stay at the top whichever topic is picked. "All" leaves them out of Latest
// (they're right above); a topic list shows every story in that topic.
const featured = await getFeaturedList();
const [feed, work, galleries, films, popular, series] = await Promise.all([
  getFeed({ topic, limit: 10, excludeIds: topic ? [] : featured.map((f) => f.id) }),
  sections.work ? listPublicEntries('project', { limit: 3 }) : Promise.resolve([]),
  sections.photos ? listPublicEntries('gallery', { limit: 6 }) : Promise.resolve([]),
  sections.film ? listPublicEntries('film', { limit: 1 }) : Promise.resolve([]),
  mostRead(5),
  listPublicSeries(3),
]);
const latestFilm = films[0];
const many = featured.length > 1;
const featuredKeys = new Set(featured.map((f) => `n:${f.id}`));
const vtName = (id: string) => `c-${id.replace(/[^a-zA-Z0-9-]/g, '')}`;
// Only the slide on screen carries its transition name (the carousel script moves it). A named element is
// painted above the page during a page transition, ignoring the track's clipping, so a named slide off to
// the side would flash into view when the page opens or a topic is picked.
const vt = (id: string) => `view-transition-name:${vtName(id)}`;
// 1–2 galleries fill the card instead of leaving empty cells: one wide photo, or two squares.
const photoCols = Math.min(galleries.length, 3);
const filmMeta = latestFilm ? [formatDate(latestFilm.published_at), latestFilm.topics.length ? topicLabel(latestFilm.topics) : ''].filter(Boolean).join(' · ') : '';
---
<Site motion intro={!topic}>
  {featured.length > 0 && (
    <section class="wrap feat" aria-roledescription={many ? 'carousel' : undefined} aria-label={many ? 'Featured stories' : undefined} data-carousel={many ? '' : undefined} style={`--feat-ms:${FEATURED_INTERVAL_S * 1000}ms`}>
      <div class="feat-track" aria-live={many ? 'off' : undefined}>
        {featured.map((f, i) => {
          const first = i === 0;
          const words = first ? f.title.trim().split(/\s+/) : [];
          const Title = first ? 'h1' : 'h2';
          return (
            <article class="featured feat-slide" role={many ? 'group' : undefined} aria-roledescription={many ? 'slide' : undefined} aria-label={many ? `${i + 1} of ${featured.length}` : undefined}>
              {(f.cover_media_id || site.defaultCoverId) && <a class:list={['cover', { 'rv-cover': first }]} data-rv={first ? 'fcover' : undefined} href={`/story/${f.slug}`} tabindex="-1" aria-hidden="true" style={f.cover_media_id && first ? vt(f.id) : undefined} data-vt={f.cover_media_id ? vtName(f.id) : undefined}>
                <span class="par"><Thumb image={f.cover_media_id ? { kind: 'media', id: f.cover_media_id } : null} eager={first} /></span>
              </a>}
              {!f.cover_media_id && !site.defaultCoverId && (
                <a class="cover cover-type" href={`/story/${f.slug}`} tabindex="-1" aria-hidden="true">
                  <span>{f.dek || f.title}</span>
                </a>
              )}
              <div class="stack">
                <Title class:list={['feat-title', { title: first, rv: first }]} data-rv={first ? 'ftitle' : undefined}>
                  <a href={`/story/${f.slug}`}>{first ? words.map((w, k) => (<><span class={`w w${Math.min(k + 1, 14)}`}><span>{w}</span></span>{k < words.length - 1 ? ' ' : ''}</>)) : f.title}</a>
                </Title>
                {f.dek && <p class:list={{ rv: first }} data-rv={first ? 'fdek' : undefined}>{f.dek}</p>}
                <span class:list={['meta', { rv: first }]} data-rv={first ? 'fmeta' : undefined}>
                  {f.topics.length > 0 && <span class="topic-name">{topicLabel(f.topics)}</span>}
                  <span>{formatDate(f.published_at)}</span>
                  <span>{f.read_minutes} min read</span>
                </span>
                <a class:list={['read', { rv: first }]} data-rv={first ? 'fread' : undefined} href={`/story/${f.slug}`}>Read <span class="arrow" aria-hidden="true">→</span><span class="sr-only">: {f.title}</span></a>
              </div>
            </article>
          );
        })}
      </div>
      {many && (
        <div class="feat-bar">
          <span></span>
          <div class="feat-ctl">
            <button type="button" class="feat-btn" data-feat="prev" aria-label="Previous featured story"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
            <button type="button" class="feat-btn" data-feat="next" aria-label="Next featured story"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
            <button type="button" class="feat-btn" data-feat="pause" aria-label="Pause featured stories">
              <svg class="i-pause" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
              <svg class="i-play" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5L19 12L8 18.5Z"/></svg>
            </button>
            <span class="feat-segs" aria-hidden="true">{featured.map(() => <span class="feat-seg"><i></i></span>)}</span>
            <span class="feat-count meta" aria-hidden="true">1 / {featured.length}</span>
          </div>
        </div>
      )}
    </section>
  )}

  <section class="wrap main">
    <div>
      <div class="list-head rv" data-rv="lhead">
        <h2>{topic ? topic : 'Latest'}</h2>
        <nav class="topics" aria-label="Filter by topic" data-topic-nav>
          <a class="topic" href="/" aria-current={topic === '' ? 'true' : undefined}>All</a>
          {site.topics.map((t) => (
            <a class="topic" href={`/?topic=${encodeURIComponent(t)}`} aria-current={topic === t ? 'true' : undefined}>{t}</a>
          ))}
        </nav>
      </div>
      <p class="sr-only" aria-live="polite" data-feed-status></p>
      <div class="feed" data-feed>
        {feed.length === 0 ? (
          <p class="empty">No posts here yet.</p>
        ) : (
          feed.map((item) => <PostRow item={item} reveal noTransition={featuredKeys.has(item.key)} />)
        )}
      </div>
      <div class="pager rv" data-rv="pager"><span></span><a data-feed-all href={topic ? `/story?topic=${encodeURIComponent(topic)}` : '/story'}>All stories <span class="arrow" aria-hidden="true">→</span></a></div>
      <AdSlot slot="home" />
    </div>

    <aside class="side" aria-label="More from sxingxian">
      <div class="card rv" data-rv="side">
        <div class="card-head"><h2 class="lbl">Subscribe</h2></div>
        <p class="card-text">New stories from here and from hey.sxingxian.com, in any feed reader.</p>
        <div class="rss-url"><span>sxingxian.com/rss.xml</span><a href="/rss.xml">RSS feed</a></div>
      </div>

      {sections.work && work.length > 0 && (
        <div class="card rv" data-rv="side">
          <div class="card-head"><h2 class="lbl">Selected work</h2><a href="/work">All work <span class="arrow" aria-hidden="true">→</span></a></div>
          {work.map((w) => (
            <a class="mini" href={`/work/${w.slug}`}>
              <span class="th"><Thumb image={w.cover_media_id ? { kind: 'media', id: w.cover_media_id } : null} /></span>
              <span class="mini-text"><b>{w.title}</b>{w.dek && <span>{w.dek}</span>}</span>
            </a>
          ))}
        </div>
      )}

      {sections.photos && galleries.length > 0 && (
        <div class="card rv" data-rv="side">
          <div class="card-head"><h2 class="lbl">Photos</h2><a href="/photos">All photos <span class="arrow" aria-hidden="true">→</span></a></div>
          <div class={`photo-grid pg-${photoCols}`}>
            {galleries.map((g) => (
              <a href={`/photos/${g.slug}`} aria-label={g.title}>
                <Thumb image={g.cover_media_id ? { kind: 'media', id: g.cover_media_id } : null} alt={g.title} />
              </a>
            ))}
          </div>
        </div>
      )}

      {sections.film && latestFilm && (
        <div class="card rv" data-rv="side">
          <div class="card-head"><h2 class="lbl">Latest film</h2><a href="/film">All films <span class="arrow" aria-hidden="true">→</span></a></div>
          <a class="mini" href={`/film/${latestFilm.slug}`}>
            <span class="th play"><Thumb image={latestFilm.cover_media_id ? { kind: 'media', id: latestFilm.cover_media_id } : null} /><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5L19 12L8 18.5Z" fill="#fff"/></svg></span>
            <span class="mini-text"><b>{latestFilm.title}</b>{filmMeta && <span>{filmMeta}</span>}</span>
          </a>
        </div>
      )}

      {popular.length > 0 && (
        <div class="card rv" data-rv="side">
          <div class="card-head"><h2 class="lbl">Most read</h2><span class="meta">Last 30 days</span></div>
          <ol class="ranked">
            {popular.map((p, i) => (
              <li><span class="n" aria-hidden="true">{i + 1}</span><a href={p.url} rel={p.external ? 'noopener' : undefined} data-view={p.external ? p.key : undefined}>{p.title}{p.external && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (on hey.sxingxian.com)</span></>}</a></li>
            ))}
          </ol>
        </div>
      )}
    </aside>
  </section>

  {series.length > 0 && (
    <section class="wrap series-sec">
      <div class="sec-head rv" data-rv="shead"><h2>Series</h2><a href="/series">All series <span class="arrow" aria-hidden="true">→</span></a></div>
      <div class="series-grid">
        {series.map((s) => <SeriesCard series={s} reveal />)}
      </div>
    </section>
  )}

  <!-- Reveal-on-view. html.motion (set in <head>) hides [data-rv] until this marks them seen.
       First visit in a session: a staggered load sequence (after the intro curtain, if shown).
       Later visits: what's on screen is shown at once; the rest reveals once as it scrolls in. -->
  <script is:inline>
  (function () {
    var d = document.documentElement;
    if (!d.classList.contains('motion')) return;
    var els = Array.prototype.slice.call(document.querySelectorAll('[data-rv]'));
    var FIXED = { fcover: 0, ftitle: 1, fdek: 2, fmeta: 3, fread: 4 };
    function reveal(list) {
      list.sort(function (a, b) { var ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect(); return Math.abs(ra.top - rb.top) < 24 ? ra.left - rb.left : ra.top - rb.top; });
      var n = list.some(function (el) { return FIXED[el.getAttribute('data-rv')] !== undefined; }) ? 3 : 0;
      list.forEach(function (el) {
        var f = FIXED[el.getAttribute('data-rv')];
        el.style.transitionDelay = ((f !== undefined ? f : Math.min(9, n++)) * 70) + 'ms';
        el.classList.add('in');
      });
    }
    var io = new IntersectionObserver(function (entries) {
      var fresh = [];
      entries.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); fresh.push(e.target); } });
      if (fresh.length) reveal(fresh);
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    function start() {
      if (start.done) return;
      start.done = true;
      // What's already on screen reveals now, in reading order; the rest waits for the observer.
      var h = window.innerHeight * 0.94, now = [];
      els.forEach(function (el) { var r = el.getBoundingClientRect(); if (r.top < h && r.bottom > 0) now.push(el); else io.observe(el); });
      if (now.length) reveal(now); // the rect reads above already flushed the hidden styles, so this transitions
    }
    if (d.classList.contains('returning')) {
      // Back on the home page this session: no load sequence for what's already on screen.
      var h = window.innerHeight;
      els.forEach(function (el) { var r = el.getBoundingClientRect(); if (r.top < h && r.bottom > 0) el.classList.add('in', 'now'); });
      requestAnimationFrame(function () { requestAnimationFrame(function () { els.forEach(function (el) { el.classList.remove('now'); }); }); });
      els = els.filter(function (el) { return !el.classList.contains('in'); });
      start();
    } else if (d.classList.contains('intro')) {
      var curtain = document.querySelector('.intro-curtain');
      var evs = ['pointerdown', 'wheel', 'touchstart', 'keydown'];
      var off = function () { evs.forEach(function (ev) { window.removeEventListener(ev, skip); }); };
      var done = function () { d.classList.remove('intro', 'intro-skip'); if (curtain) curtain.remove(); off(); };
      var t1 = setTimeout(start, 1250);   // the page's own reveal begins under the lifting curtain
      var t2 = setTimeout(done, 1800);
      var skip = function () { clearTimeout(t1); clearTimeout(t2); d.classList.add('intro-skip'); start(); setTimeout(done, 240); off(); };
      evs.forEach(function (ev) { window.addEventListener(ev, skip, { passive: true }); });
    } else {
      start();
    }
    d.setAttribute('data-rv-ready', '');
  })();
  </script>
  <script is:inline>
    // Topic chips: swap the Latest list in place (no page load, address unchanged). The chips stay real
    // links, so this is only an enhancement: modified clicks and failures fall back to normal navigation.
    (function () {
      var nav = document.querySelector('[data-topic-nav]');
      var feed = document.querySelector('[data-feed]');
      if (!nav || !feed || !window.fetch || !window.DOMParser) return;
      var head = document.querySelector('.list-head h2');
      var all = document.querySelector('[data-feed-all]');
      var status = document.querySelector('[data-feed-status]');
      var ctl = null, vt = null;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      nav.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a.topic');
        if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        if (a.getAttribute('aria-current') === 'true') return;
        var topic = new URL(a.href, location.href).searchParams.get('topic') || '';
        if (ctl) { ctl.abort(); if (window.sxLoad) window.sxLoad.done(); }
        ctl = new AbortController();
        // Answer the tap straight away: the chip turns on now, the list follows when it arrives.
        nav.querySelectorAll('a.topic').forEach(function (x) { if (x === a) x.setAttribute('aria-current', 'true'); else x.removeAttribute('aria-current'); });
        if (head) head.textContent = topic || 'Latest';
        feed.setAttribute('aria-busy', 'true');
        if (window.sxLoad) window.sxLoad.start();
        if (status) status.textContent = 'Loading' + (topic ? ' ' + topic : '') + '…';
        fetch('/partials/home-feed?topic=' + encodeURIComponent(topic), { signal: ctl.signal, credentials: 'same-origin', headers: { Accept: 'text/html' } })
          .then(function (r) { if (!r.ok) throw new Error(String(r.status)); return r.text(); })
          .then(function (html) {
            var tpl = new DOMParser().parseFromString(html, 'text/html').querySelector('template[data-topic]');
            if (!tpl) throw new Error('bad fragment');
            var apply = function () {
              feed.replaceChildren(document.importNode(tpl.content, true));
              if (all) all.setAttribute('href', tpl.getAttribute('data-all') || '/story');
            };
            // One transition at a time: a quick second click finishes the first one instantly.
            if (vt) { try { vt.skipTransition(); } catch (e2) {} }
            if (document.startViewTransition && !reduce.matches && !document.hidden) {
              vt = document.startViewTransition(apply);
              var done = function () { vt = null; };
              vt.ready.catch(function () {});
              vt.finished.then(done, done);
            } else apply();
            var n = Number(tpl.getAttribute('data-count')) || 0;
            if (status) status.textContent = n ? 'Showing ' + n + (n === 1 ? ' story' : ' stories') + (topic ? ' in ' + topic : '') : 'No stories' + (topic ? ' in ' + topic : '');
          })
          .catch(function (err) { if (err && err.name === 'AbortError') return; location.href = a.href; })
          .finally(function () { feed.removeAttribute('aria-busy'); if (window.sxLoad) window.sxLoad.done(); });
      });
    })();

    // Featured carousel: scroll-snap track (swipe, trackpad and keyboard scrolling work without this script).
    // Advances when the current progress bar finishes (CSS animation, --feat-ms). Pauses on hover, keyboard
    // focus, the pause button and when the tab is hidden; never advances by itself with reduced motion.
    (function () {
      var root = document.querySelector('[data-carousel]');
      if (!root) return;
      var track = root.querySelector('.feat-track');
      var slides = Array.prototype.slice.call(track.children);
      var segs = Array.prototype.slice.call(root.querySelectorAll('.feat-seg'));
      var count = root.querySelector('.feat-count');
      var pauseBtn = root.querySelector('[data-feat="pause"]');
      var n = slides.length, cur = 0, scrollT = 0;
      var userPaused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var hold = { hover: false, focus: false, hidden: document.hidden };
      root.classList.add('is-live');

      function paused() { return userPaused || hold.hover || hold.focus || hold.hidden; }
      function sync() {
        root.classList.toggle('is-paused', paused());
        root.classList.toggle('user-paused', userPaused);
        pauseBtn.setAttribute('aria-label', userPaused ? 'Play featured stories' : 'Pause featured stories');
        track.setAttribute('aria-live', paused() ? 'polite' : 'off');
      }
      function mark(i) {
        cur = i;
        segs.forEach(function (s, k) {
          s.classList.toggle('done', k < i);
          s.classList.remove('on');
        });
        void segs[i].offsetWidth; // restart the fill animation
        segs[i].classList.add('on');
        count.textContent = (i + 1) + ' / ' + n;
        slides.forEach(function (sl, k) {
          var c = sl.querySelector('[data-vt]');
          if (c) c.style.viewTransitionName = k === i ? c.getAttribute('data-vt') : '';
        });
      }
      function go(i, instant) {
        i = (i + n) % n;
        mark(i);
        track.scrollTo({ left: slides[i].offsetLeft, behavior: instant || userPaused ? 'auto' : 'smooth' });
      }
      segs.forEach(function (s, k) {
        s.firstChild.addEventListener('animationend', function () { if (k === cur && !paused()) go(cur + 1); });
      });
      // A swipe or trackpad scroll picks the slide it settles on.
      track.addEventListener('scroll', function () {
        clearTimeout(scrollT);
        scrollT = setTimeout(function () {
          var i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
          if (i !== cur && i >= 0 && i < n) mark(i);
        }, 120);
      }, { passive: true });
      root.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-feat]');
        if (!b) return;
        var a = b.getAttribute('data-feat');
        if (a === 'prev') go(cur - 1);
        else if (a === 'next') go(cur + 1);
        else { userPaused = !userPaused; sync(); }
      });
      root.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') { hold.hover = true; sync(); } });
      root.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') { hold.hover = false; sync(); } });
      root.addEventListener('focusin', function () { hold.focus = true; sync(); });
      root.addEventListener('focusout', function (e) { if (!root.contains(e.relatedTarget)) { hold.focus = false; sync(); } });
      document.addEventListener('visibilitychange', function () { hold.hidden = document.hidden; sync(); });
      sync();
      mark(0);
    })();
  </script>
</Site>
