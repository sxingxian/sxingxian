---
// Where Stripe and PayPal send a visitor after paying. Confirms the payment with the provider first
// (for PayPal this is when the money is actually taken), so the page never thanks for a payment that failed.
import Site from '../../layouts/Site.astro';
import { finishReturn, type ReturnView } from '../../lib/server/sponsor';

Astro.response.headers.set('cache-control', 'no-store');
const via = Astro.url.searchParams.get('via');
const ref = Astro.url.searchParams.get('ref') ?? '';
let view: ReturnView = { state: 'unknown', amount: null, back: '/', via: 'stripe' };
if (via === 'stripe' || via === 'paypal') {
  try {
    view = await finishReturn(ref, via);
  } catch {
    view = { state: 'unknown', amount: null, back: '/', via };
  }
}
const who = view.via === 'paypal' ? 'PayPal' : 'Stripe';
const backLabel = view.back.startsWith('/story/') ? 'Back to the story' : 'Back to the site';
---
<Site title={view.state === 'paid' ? 'Thank you' : 'Your sponsor'} noindex>
  <div class="wrap sponsor-done">
    {view.state === 'paid' ? (
      <>
        <span class="done-icon ok" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3.5 8.5l3 3 6-7" /></svg></span>
        <h1>Thank you</h1>
        <p>Your {view.amount} sponsor came through. A receipt is on its way from {who} to the email you used.</p>
      </>
    ) : view.state === 'processing' ? (
      <>
        <span class="done-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="8" r="6" /><path d="M8 4.5V8l2.5 1.5" /></svg></span>
        <h1>Thank you</h1>
        <p>{who} is still confirming your {view.amount} payment. This usually takes a moment; {who} will email you once it’s done.</p>
      </>
    ) : view.state === 'declined' ? (
      <>
        <span class="done-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="8" r="6" /><path d="M8 5v3.5M8 11h.01" /></svg></span>
        <h1>The payment didn’t go through</h1>
        <p>{who} couldn’t take the payment, so nothing was charged. You can try again, or use the other way to pay.</p>
      </>
    ) : (
      <>
        <span class="done-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="8" r="6" /><path d="M8 5v3.5M8 11h.01" /></svg></span>
        <h1>We couldn’t find that payment</h1>
        <p>If you paid, {who} has emailed you a receipt and nothing more is needed. Otherwise you can start again from the sponsor page.</p>
      </>
    )}
    <div class="done-actions">
      {view.state === 'paid' || view.state === 'processing' ? (
        <a class="sponsor-btn ghost" href={view.back}><span aria-hidden="true">←</span> {backLabel}</a>
      ) : (
        <>
          <a class="sponsor-btn" href="/sponsor">Try again</a>
          <a class="sponsor-btn ghost" href={view.back}><span aria-hidden="true">←</span> {backLabel}</a>
        </>
      )}
    </div>
  </div>
  {(view.state === 'paid' || view.state === 'processing') && (
    <script is:inline>try { sessionStorage.removeItem('sx-sponsor-draft'); } catch (e) {}</script>
  )}
</Site>
