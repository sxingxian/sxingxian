---
import Site from '../../layouts/Site.astro';
import PostRow from '../../components/PostRow.astro';
import { ARCHIVE_PAGE_SIZE, feedPage, feedYears } from '../../lib/server/site';
import { listPublicSeries } from '../../lib/server/series';
import { getSetting } from '../../lib/server/repo';

// /story?topic=…&year=…&page=… — every parameter is checked against what exists; anything else is ignored.
const site = await getSetting('site');
const q = Astro.url.searchParams;
const raw = q.get('topic') ?? '';
const topic = site.topics.includes(raw) ? raw : '';
const years = await feedYears({ topic });
const rawYear = Number(q.get('year'));
const year = Number.isInteger(rawYear) && years.some((y) => y.year === rawYear) ? rawYear : null;
const rawPage = Number(q.get('page'));
const askedPage = Number.isInteger(rawPage) && rawPage >= 1 && rawPage <= 10_000 ? rawPage : 1;
const [{ items, total, page, pages }, series] = await Promise.all([
  feedPage({ topic, year, page: askedPage }),
  listPublicSeries(6),
]);

const href = (o: { topic?: string; year?: number | null; page?: number }) => {
  const p = new URLSearchParams();
  const t = o.topic ?? topic;
  const y = o.year === undefined ? year : o.year;
  if (t) p.set('topic', t);
  if (y) p.set('year', String(y));
  if (o.page && o.page > 1) p.set('page', String(o.page));
  const s = p.toString();
  return s ? `/story?${s}` : '/story';
};
// Group the page's stories by year when showing every year.
const groups: [string, typeof items][] = [];
for (const item of items) {
  const y = new Intl.DateTimeFormat('en-SG', { year: 'numeric', timeZone: 'Asia/Singapore' }).format(new Date(item.date));
  const last = groups[groups.length - 1];
  if (last && last[0] === y) last[1].push(item);
  else groups.push([y, [item]]);
}
// Page numbers: first, last, and two either side of the current one.
const nums: (number | 'gap')[] = [];
for (let i = 1; i <= pages; i++) {
  if (i === 1 || i === pages || Math.abs(i - page) <= 2) nums.push(i);
  else if (nums[nums.length - 1] !== 'gap') nums.push('gap');
}
const from = total ? (page - 1) * ARCHIVE_PAGE_SIZE + 1 : 0;
const to = Math.min(total, page * ARCHIVE_PAGE_SIZE);
const allCount = years.reduce((n, y) => n + y.count, 0);
const title = [topic || 'All stories', year ? String(year) : '', page > 1 ? `page ${page}` : ''].filter(Boolean).join(' · ');
---
<Site title={title} description="Every story, newest first.">
  <section class="wrap archive">
    <header class="page-head">
      <h1>{topic || 'All stories'}</h1>
      <p>Newest first, including posts from hey.sxingxian.com.</p>
    </header>
    <nav class="topics" aria-label="Filter by topic" style="margin-top:16px">
      <a class="topic" href={href({ topic: '', year: null })} aria-current={topic === '' ? 'true' : undefined}>All</a>
      {site.topics.map((t) => (
        <a class="topic" href={href({ topic: t, year: null })} aria-current={topic === t ? 'true' : undefined}>{t}</a>
      ))}
    </nav>
    {years.length > 1 && (
      <nav class="topics years-chips" aria-label="Filter by year">
        <a class="topic" href={href({ year: null })} aria-current={year === null ? 'true' : undefined}>All years</a>
        {years.map((y) => <a class="topic" href={href({ year: y.year })} aria-current={year === y.year ? 'true' : undefined}>{y.year}</a>)}
      </nav>
    )}

    <div class="main">
      <div>
        <div class="year-head">
          <h2>{year ?? 'All years'}</h2>
          {total > 0 && <span class="meta">{from}–{to} of {total}</span>}
        </div>
        {items.length === 0 && <p class="empty">No stories yet.</p>}
        {year !== null
          ? items.map((item) => <PostRow item={item} />)
          : groups.map(([y, list], i) => (
              <>
                {(i > 0 || groups.length > 1) && <h3 class="year">{y}</h3>}
                {list.map((item) => <PostRow item={item} />)}
              </>
            ))}
        {pages > 1 && (
          <nav class="pages" aria-label="Pages">
            {page > 1 ? <a class="pg" href={href({ page: page - 1 })} rel="prev">‹ Newer</a> : <span class="pg" aria-disabled="true">‹ Newer</span>}
            <span class="nums" data-label={`Page ${page} of ${pages}`}>
              {nums.map((n) => n === 'gap'
                ? <span class="pg gap" aria-hidden="true">…</span>
                : <a class="pg" href={href({ page: n })} aria-current={n === page ? 'page' : undefined} aria-label={`Page ${n}`}>{n}</a>)}
            </span>
            {page < pages ? <a class="pg" href={href({ page: page + 1 })} rel="next">Older ›</a> : <span class="pg" aria-disabled="true">Older ›</span>}
          </nav>
        )}
      </div>

      <aside class="side side-sticky" aria-label="Browse stories">
        {years.length > 0 && (
          <div class="card years-card">
            <div class="card-head"><h2 class="lbl">Years</h2></div>
            <nav class="years" aria-label="Filter by year">
              <a href={href({ year: null })} aria-current={year === null ? 'true' : undefined}><span>All years</span><span class="meta">{allCount}</span></a>
              {years.map((y) => (
                <a href={href({ year: y.year })} aria-current={year === y.year ? 'true' : undefined}><span>{y.year}</span><span class="meta">{y.count}</span></a>
              ))}
            </nav>
          </div>
        )}
        {series.length > 0 && (
          <div class="card">
            <div class="card-head"><h2 class="lbl">Series</h2><a href="/series">All series <span class="arrow" aria-hidden="true">→</span></a></div>
            {series.map((s) => (
              <a class="mini" href={`/series/${s.slug}`}>
                <span class="mini-text"><b>{s.title}</b><span>{s.planned_parts && s.planned_parts > s.published ? `${s.published} of ${s.planned_parts} parts` : `${s.published} ${s.published === 1 ? 'part' : 'parts'}`}</span></span>
              </a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </section>
</Site>
