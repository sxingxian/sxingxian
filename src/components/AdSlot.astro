---
// One Google AdSense display unit. Renders nothing unless ads are on, allowed on this page
// (place switched on, not an error or hidden page, enough text) and the slot ID is set. The push() script gets the page's CSP nonce like every script.
import { adsFor, validSlot } from '../lib/server/ads';

interface Props { slot: 'home' | 'article' }
const ads = await adsFor(Astro.url.pathname, Astro.locals.adFacts);
const id = ads ? (Astro.props.slot === 'home' ? ads.homeSlot : ads.articleSlot) : '';
const show = !!ads && validSlot(id);
---
{show && ads && (
  <aside class="ad" aria-label="Advertisement">
    <span class="ad-lbl">Advertisement</span>
    <ins class="adsbygoogle" data-ad-client={ads.client} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
