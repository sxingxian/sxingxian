---
// Detail page body. The page loads the entry (loadPublicEntry) and sets the 404 status itself:
// a component renders after the response has started, too late to change the status.
import EntryArticle from './EntryArticle.astro';
import NotFound from './NotFound.astro';
import type { Entry } from '../lib/shared/types';

interface Props {
  entry: Entry | null;
  kicker: string;
}
const { entry, kicker } = Astro.props;
---
{entry ? <EntryArticle entry={entry} kicker={kicker} /> : <NotFound />}
