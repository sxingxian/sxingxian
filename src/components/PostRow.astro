---
import Thumb from './Thumb.astro';
import type { FeedItem } from '../lib/server/site';
import { formatDate } from '../lib/server/text';
import { topicLabel } from '../lib/shared/types';
interface Props {
  item: FeedItem;
  reveal?: boolean;
  /** Leave out the shared transition name (the same story is already on the page, e.g. in the featured carousel). */
  noTransition?: boolean;
}
const { item, reveal = false, noTransition = false } = Astro.props;
// Native posts share a view-transition name with the post's cover, so the thumbnail grows into it.
const vtName = !noTransition && item.source === 'native' && item.image ? `c-${item.key.slice(2).replace(/[^a-zA-Z0-9-]/g, '')}` : null;
---
<a class:list={['post-row', { rv: reveal, 'no-thumb': !item.image }]} href={item.url} rel={item.external ? 'noopener' : undefined} data-rv={reveal ? 'row' : undefined} data-view={item.external ? item.key : undefined}>
  {item.image && <span class="thumb" style={vtName ? `view-transition-name:${vtName}` : undefined}><Thumb image={item.image} /></span>}
  <span class="body">
    <span class="t"><span class="uline">{item.title}</span></span>
    {item.dek && <span class="d">{item.dek}</span>}
    <span class="meta">
      {item.topics.length > 0 && <span class="topic-name">{topicLabel(item.topics)}</span>}
      <span>{formatDate(item.date, { day: 'numeric', month: 'short' })}</span>
      <span>{item.readMinutes} min read</span>
      {item.external && <span>hey.sxingxian.com <span aria-hidden="true">↗</span></span>}
    </span>
  </span>
</a>
