{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sxingxian",
  // Custom entry: Astro's fetch handler + the cron handler for WordPress sync.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "sxingxian.com", "custom_domain": true }
  ],
  // Only the custom domain above: no workers.dev address and no per-version preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  // Keep variables and secrets set in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true },

  // Fixed, non-secret values. Everything specific to your accounts
  // (DATABASE_URL, AUTH_SECRET, SETUP_TOKEN, WP_WEBHOOK_SECRET, optional NAS_/B2_ storage) is set in Cloudflare → sxingxian → Settings →
  // Variables and secrets, and kept across deploys by "keep_vars". See docs/DEPLOYMENT.md.
  "vars": {
    "SITE_URL": "https://sxingxian.com",
    "WP_BASE_URL": "https://hey.sxingxian.com"
  },

  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "sxingxian-media" }
  ],

  // Rate limits: the public WordPress webhook, and sign-in/setup attempts per IP address.
  "ratelimits": [
    { "name": "WEBHOOK_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  // Every 5 min: WordPress health check (+ incremental pull every 15 min).
  // 19:00 UTC = 03:00 SGT: nightly reconcile to catch deletions, and removal of expired sessions.
  "triggers": {
    "crons": ["*/5 * * * *", "0 19 * * *"]
  }
}
