{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "wordpress-plugin"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@admin/*": ["src/admin/*"]
    }
  }
}
